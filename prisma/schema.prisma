// Modelo de datos del portfolio.
// Base PostgreSQL (en producción, Neon). DATABASE_URL es la conexión "pooled"
// que usa la app; DATABASE_URL_UNPOOLED es la directa que usa Prisma para
// crear o actualizar las tablas (prisma db push).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// role: "USER" | "PHOTOGRAPHER" | "ADMIN" (ver src/lib/permissions.ts)
model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("USER")
  active       Boolean        @default(true)
  canDownload  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  favorites    Favorite[]
  photos       Photo[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  photos      Photo[]
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  photos Photo[]
}

model Photo {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  description  String?
  takenAt      DateTime?
  theme        String?
  location     String?
  camera       String?

  published    Boolean    @default(false)
  featured     Boolean    @default(false)
  downloadable Boolean    @default(true)

  // Archivo ORIGINAL (alta resolución, privado, sólo se entrega como descarga).
  // Las rutas (originalPath, displayPath, thumbPath) son claves dentro del
  // almacenamiento: "originals/…", "display/…", "thumbs/…" (ver lib/storage.ts)
  originalPath String
  originalName String
  originalMime String
  originalSize Int
  width        Int
  height       Int

  // Versiones OPTIMIZADAS (webp, públicas, cacheables) para navegar rápido.
  // Las genera el navegador de la fotógrafa al subir (lib/client-image.ts)
  displayPath  String
  displaySize  Int
  thumbPath    String
  blurDataUrl  String

  views        Int        @default(0)
  downloads    Int        @default(0)

  // Campos calculados que guardamos para poder filtrar y ordenar en la base
  // (indispensable con cientos o miles de fotos). Los mantiene lib/photo-index.ts
  orientation    String   @default("horizontal") // horizontal | vertical | cuadrada
  favoritesCount Int      @default(0)
  popularity     Int      @default(0) // visitas + descargas×3 + favoritos×5
  searchText     String   @default("") // título, tema, lugar, etiquetas… sin tildes y en minúsculas

  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         Tag[]
  favorites    Favorite[]
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([published, takenAt])
  @@index([published, popularity])
  @@index([published, createdAt])
  @@index([categoryId])
  @@index([theme])
}

model Favorite {
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Contenido editable del sitio (nombre de la fotógrafa, textos, redes...)
model Setting {
  key   String @id
  value String
}
