# ── Base de datos PostgreSQL ─────────────────────────────────────────────
# En Vercel las carga sola la integración con Neon. En tu computadora usá una
# base de Neon aparte (por ejemplo una rama "desarrollo") o un Postgres local.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/portfolio"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@localhost:5432/portfolio"

# ── Sesiones ─────────────────────────────────────────────────────────────
# Clave para firmar las sesiones. Generala con: npx auth secret
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# ── Fotos ────────────────────────────────────────────────────────────────
# Sin las variables S3_* las fotos se guardan en la carpeta STORAGE_DIR
# (cómodo para probar en tu computadora). En producción se usa Cloudflare R2.
STORAGE_DIR="./storage"
# S3_ENDPOINT="https://<ID-de-cuenta>.r2.cloudflarestorage.com"
# S3_BUCKET="portfolio-delfina"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Dirección pública del bucket (Public Development URL de R2), sin "/" final
# S3_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
